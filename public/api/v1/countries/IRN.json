953561,101255637,101535318,101790184,102017424,102213901,102377160,102506408,102601146,102660431,102682299,102665205,102609156,102514923,102382597,102213198,102007508,101767107,101493018,101187094,100851951,100489518,100102783,99692818,99260221,98807525,98337252,97851846,97353895,96844685,96325679,95799865,95269010,94735374,94201375,93668700,93138980,92613178,92093626,91581347,91075936,90578174,90089455,89608789,89135021,88667892,88206954,87750428,87296889,86845459,86393801,85939697,85481182,85017727,84549677,84076671,83597557]},"crossChecks":[{"key":"today","kind":"unsd","asOf":"2026-10-05","figure":{"value":86562000,"what":"official estimate the country reported to the UN Statistics Division","date":"2025","provisional":true,"estimated":false},"unFigure":{"value":92417681,"what":"UN figure for 1 July 2025 (the national figure's period can't be lined up with a day)","date":"2025-07-01","forecast":true},"notes":["Data refer to the Iranian Year which begins on 21 March and ends on 20 March of the following year."],"gapPct":null,"verdict":"context","links":[{"label":"UN Statistics Division: latest census and estimates (table 2)","href":"https://unstats.un.org/unsd/demographic-social/products/vitstats/seratab2.pdf"}]},{"key":"births","kind":"unsd","asOf":"2026-10-05","figure":{"value":1057948,"what":"births registered (registration reported as virtually complete)","date":"2023","provisional":false,"estimated":false},"notes":["Data refer to the Iranian Year which begins on 21 March and ends on 20 March of the following year."],"unFigure":{"value":1173463,"what":"UN figure for 2023","date":"2023","forecast":false},"gapPct":10.9,"verdict":"un-higher","links":[{"label":"UN Statistics Division: births and deaths (table 3)","href":"https://unstats.un.org/unsd/demographic-social/products/vitstats/seratab3.pdf"}]},{"key":"deaths","kind":"unsd","asOf":"2026-10-05","figure":{"value":403202,"what":"deaths registered (registration reported as virtually complete)","date":"2023","provisional":false,"estimated":false},"notes":["Data refer to the Iranian Year which begins on 21 March and ends on 20 March of the following year."],"unFigure":{"value":423367,"what":"UN figure for 2023","date":"2023","forecast":false},"gapPct":5,"verdict":"un-higher","links":[{"label":"UN Statistics Division: births and deaths (table 3)","href":"https://unstats.un.org/unsd/demographic-social/products/vitstats/seratab3.pdf"}]},{"key":"net","kind":"researched","text":"UNHCR counted more than 1.9 million Afghans who returned or were deported from Iran to Afghanistan in 2025, and 581,600 more in 2026 up to 3 October. The UN's forecast shows Iran gaining about 117,000 people from migration in 2025, so it misses this large outflow.","figure":{"value":-1900000,"what":"Afghans who returned or were deported from Iran to Afghanistan in 2025 (an outflow, not a full net migration figure)","date":"2025"},"unFigure":{"value":116786,"what":"UN net migration forecast for Iran in 2025","date":""},"gapPct":-106.1,"verdict":"un-higher","links":[{"label":"UNHCR, Afghanistan situation: Afghan returns from Iran, emergency update, published 8 Oct 2026","href":"https://data.unhcr.org/en/documents/download/124400"},{"label":"UNHCR briefing note: UNHCR warns regional conflicts could drive increased returns to Afghanistan, 10 Mar 2026","href":"https://www.unhcr.org/uk/news/briefing-notes/unhcr-warns-regional-conflicts-could-drive-increased-returns-afghanistan"}],"quotes":[{"text":"In 2025, more than 1.9 million Afghans returned or were deported from Iran – many not by choice. In 2026, a further 581,600 Afghans have returned.","href":"https://data.unhcr.org/en/documents/download/124400"},{"text":"Over 5 million Afghans returned from neighbouring countries over the past two years – almost 1.9 million from Iran in 2025 alone.","href":"https://www.unhcr.org/uk/news/briefing-notes/unhcr-warns-regional-conflicts-could-drive-increased-returns-afghanistan"}],"accessed":"2026-10-29"},{"key":"immigrants","kind":"researched","text":"UNHCR counts 1.65 million refugees and others in need of protection in Iran in 2026. That is a narrower group than the UN's 3.84 million people born abroad in mid-2024. Almost 1.9 million Afghans also returned or were deported from Iran in 2025.","figure":{"value":1650000,"what":"refugees and others in need of international protection in Iran (not everyone born abroad)","date":"2026"},"unFigure":{"value":3840654,"what":"UN DESA people born abroad living in Iran, mid-2024","date":""},"gapPct":132.8,"verdict":"context","links":[{"label":"UNHCR, Afghanistan situation: Afghan returns from Iran, emergency update, published 8 Oct 2026","href":"https://data.unhcr.org/en/documents/download/124400"}],"quotes":[{"text":"1.65 Million Refugees and others in need of international protection in Iran Source: UNHCR","href":"https://data.unhcr.org/en/documents/download/124400"},{"text":"On 20 March 2025, headcount slips for an estimated 2 million Afghans in Iran expired, after which the Government introduced a regularization and return scheme, requiring slip holders to undergo assessments to determine whether they can remain.","href":"https://data.unhcr.org/en/documents/download/124400"}],"accessed":"2026-10-29"}],"links":{"self":"https://fertility-tracker-live.vercel.app/api/v1/countries/IRN.json","countries":"https://fertility-tracker-live.vercel.app/api/v1/countries.json","risk":"https://fertility-tracker-live.vercel.app/api/v1/risk.json","docs":"https://fertility-tracker-live.vercel.app/api/","site":"https://fertility-tracker-live.vercel.app/country/IRN"}}
