73450234,177880393,182363407,186901004,191492527,196132426,200819846,205553158,210329305,215146671,220000728,224887844,229805607,234747853,239707181,244680364,249662177,254648127,259641714,264643998,269647834,274646661,279636927,284613433,289570614,294507836,299427608,304330469,309211709,314068858,318897626,323696628,328466195,333203003,337902593,342563378,347187427,351775653,356323629,360828077,365288186,369699383,374064557,378385136,382656254,386870688,391018972,395095462,399105039,403043985,406904874,410691968,414404052,418038597,421600883,425087906,428493748,431818823,435065376,438233829,441324531]},"crossChecks":[{"key":"today","kind":"researched","text":"DR Congo's statistics office (INS), projecting from the 1984 census, estimated 98.4 million people in 2019 in its 2020 statistical yearbook, its latest published national estimate we found. The UN's figure for mid-2019 is 92.9 million, about 5.5% lower.","figure":{"value":98370000,"what":"INS estimated population of DR Congo in 2019, projected from the 1984 census","date":"2019"},"unFigure":{"value":92947442,"what":"UN estimate of DR Congo's population on 1 July 2019","date":""},"gapPct":-5.5,"verdict":"un-lower","links":[{"label":"Institut National de la Statistique (RDC), Annuaire statistique RDC 2020, March 2021 (copy hosted by CCI France)","href":"https://aws-a.medias-ccifi.org/fileadmin/repcongo/user_upload/ANNUAIRE-STAT.-2020_RDC_2_.pdf"}],"quotes":[{"text":"Tableau 28 ››  Superficie et population estimée de la RDC par province en 2019 N° Provinces Chef-lieu Superficie/km² Population (en milliers) RDC 2 345 410 98 370","href":"https://aws-a.medias-ccifi.org/fileadmin/repcongo/user_upload/ANNUAIRE-STAT.-2020_RDC_2_.pdf"},{"text":"(I) que les données sur la population sont tirées des projections démographiques effectuées par l’Institut National de la Statistique sur base des données du recensement de 1984, faute de mieux.","href":"https://aws-a.medias-ccifi.org/fileadmin/repcongo/user_upload/ANNUAIRE-STAT.-2020_RDC_2_.pdf"}],"accessed":"2026-10-29"},{"key":"net","kind":"researched","text":"The UN refugee agency's count of Congolese refugees and asylum seekers abroad rose by 158,000 between the end of 2022 and the end of 2024, to 1.23 million. The UN's figures show only 42,000 more people leaving than arriving over 2023–2024. Another 6.9 million people were displaced inside the country at the end of 2024.","figure":{"value":-157763,"what":"Rise in Congolese refugees and asylum seekers abroad (UNHCR), end-2022 to end-2024, shown as an outflow","date":"2022-12-31 to 2024-12-31"},"unFigure":{"value":-41960,"what":"UN net migration for DR Congo, 2023 plus 2024","date":""},"gapPct":73.4,"verdict":"context","links":[{"label":"UNHCR Refugee Data Finder API, people displaced from DR Congo, 2022–2025","href":"https://api.unhcr.org/population/v1/population/?limit=20&dataset=population&displayType=totals&yearFrom=2022&yearTo=2025&coo=COD&columns%5B%5D=refugees&columns%5B%5D=asylum_seekers&columns%5B%5D=idps&columns%5B%5D=returned_refugees&columns%5B%5D=returned_idps"}],"quotes":[{"text":"{\"year\":2022,\"coo_id\":41,\"coo_name\":\"Dem. Rep. of the Congo\",\"coo\":\"COD\",\"coo_iso\":\"COD\",\"coa_id\":\"-\",\"coa_name\":\"-\",\"coa\":\"-\",\"coa_iso\":\"-\",\"refugees\":932680,\"asylum_seekers\":135099,\"idps\":5541021,\"returned_refugees\":11253,\"returned_idps\":1216942}","href":"https://api.unhcr.org/population/v1/population/?limit=20&dataset=population&displayType=totals&yearFrom=2022&yearTo=2025&coo=COD&columns%5B%5D=refugees&columns%5B%5D=asylum_seekers&columns%5B%5D=idps&columns%5B%5D=returned_refugees&columns%5B%5D=returned_idps"},{"text":"{\"year\":2024,\"coo_id\":41,\"coo_name\":\"Dem. Rep. of the Congo\",\"coo\":\"COD\",\"coo_iso\":\"COD\",\"coa_id\":\"-\",\"coa_name\":\"-\",\"coa\":\"-\",\"coa_iso\":\"-\",\"refugees\":1060086,\"asylum_seekers\":165456,\"idps\":6905511,\"returned_refugees\":575,\"returned_idps\":2361409}","href":"https://api.unhcr.org/population/v1/population/?limit=20&dataset=population&displayType=totals&yearFrom=2022&yearTo=2025&coo=COD&columns%5B%5D=refugees&columns%5B%5D=asylum_seekers&columns%5B%5D=idps&columns%5B%5D=returned_refugees&columns%5B%5D=returned_idps"}],"accessed":"2026-10-29"},{"key":"immigrants","kind":"researched","text":"The UN refugee agency counted 518,000 refugees and asylum seekers living in DR Congo at the end of 2024. The UN's figure of 1.09 million people born abroad in mid-2024 is about twice that, because it also counts people born abroad who are not refugees. We found no national count to check it against.","figure":{"value":518445,"what":"Refugees and asylum seekers living in DR Congo (UNHCR), end-2024","date":"2024-12-31"},"unFigure":{"value":1085090,"what":"UN DESA: people born abroad living in DR Congo, mid-2024","date":""},"gapPct":109.3,"verdict":"context","links":[{"label":"UNHCR Refugee Data Finder API, refugees and asylum seekers hosted in DR Congo, 2022–2025","href":"https://api.unhcr.org/population/v1/population/?limit=20&dataset=population&displayType=totals&yearFrom=2022&yearTo=2025&coa=COD&columns%5B%5D=refugees&columns%5B%5D=asylum_seekers&columns%5B%5D=idps&columns%5B%5D=returned_refugees&columns%5B%5D=returned_idps"}],"quotes":[{"text":"{\"year\":2024,\"coo_id\":\"-\",\"coo_name\":\"-\",\"coo\":\"-\",\"coo_iso\":\"-\",\"coa_id\":41,\"coa_name\":\"Dem. Rep. of the Congo\",\"coa\":\"COD\",\"coa_iso\":\"COD\",\"refugees\":517404,\"asylum_seekers\":1041,\"idps\":6905511,\"returned_refugees\":15466,\"returned_idps\":2361409}","href":"https://api.unhcr.org/population/v1/population/?limit=20&dataset=population&displayType=totals&yearFrom=2022&yearTo=2025&coa=COD&columns%5B%5D=refugees&columns%5B%5D=asylum_seekers&columns%5B%5D=idps&columns%5B%5D=returned_refugees&columns%5B%5D=returned_idps"}],"accessed":"2026-10-29"}],"links":{"self":"https://fertility-tracker-live.vercel.app/api/v1/countries/COD.json","countries":"https://fertility-tracker-live.vercel.app/api/v1/countr