{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rostyslavdzhohola.github.io/fertility-tracker/api/v1/schema/countries.schema.json",
  "title": "Fertility Tracker: countries.json",
  "description": "countries.json",
  "type": "object",
  "required": [
    "apiVersion",
    "generatedAt",
    "latestEstimateYear",
    "replacementTfr",
    "count",
    "sources",
    "countries"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "description": "API version.",
      "const": "v1"
    },
    "generatedAt": {
      "type": "string",
      "description": "When the numbers last changed (ISO 8601).",
      "format": "date-time"
    },
    "latestEstimateYear": {
      "type": "integer",
      "description": "Latest UN WPP estimate year (components year and projection baseline)."
    },
    "replacementTfr": {
      "type": "number",
      "description": "Replacement fertility used throughout.",
      "const": 2.1
    },
    "count": {
      "type": "integer",
      "description": "Number of records."
    },
    "sources": {
      "type": "object",
      "description": "Source ids used in records -> full names (details in index.json).",
      "additionalProperties": {
        "type": "string",
        "description": "Source name."
      }
    },
    "countries": {
      "type": "array",
      "description": "One record per country, sorted by iso3 (includes WLD).",
      "items": {
        "$ref": "#/$defs/country"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "country": {
      "type": "object",
      "description": "Country summary.",
      "required": [
        "iso3",
        "isoNumeric",
        "name",
        "region",
        "incomeGroup",
        "ranked",
        "flags",
        "population",
        "tfr",
        "medianAge",
        "share65",
        "components",
        "migrantStock",
        "projection",
        "generations",
        "risk"
      ],
      "properties": {
        "iso3": {
          "type": "string",
          "description": "ISO 3166-1 alpha-3 code (WLD = world, XKX = Kosovo).",
          "pattern": "^[A-Z]{3}$"
        },
        "isoNumeric": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO 3166-1 numeric code (3 digits), the id used by common world map files. Null for WLD and XKX.",
          "pattern": "^[0-9]{3}$"
        },
        "name": {
          "type": "string",
          "description": "Short English name."
        },
        "region": {
          "type": "string",
          "description": "World Bank region (\"World\" for WLD)."
        },
        "incomeGroup": {
          "type": [
            "string",
            "null"
          ],
          "description": "World Bank income group, null if not classified."
        },
        "ranked": {
          "type": "boolean",
          "description": "True if the country is included in the risk ranking (population >= 100,000 and complete inputs)."
        },
        "flags": {
          "type": "array",
          "description": "Data-quality flags.",
          "items": {
            "type": "string",
            "description": "Flag.",
            "enum": [
              "aggregate",
              "no-world-bank-data",
              "small-population",
              "incomplete-risk-inputs"
            ]
          }
        },
        "population": {
          "type": [
            "object",
            "null"
          ],
          "description": "Population (latest of World Bank / UN).",
          "required": [
            "value",
            "year",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number",
              "description": "The value."
            },
            "year": {
              "type": "integer",
              "description": "Year the value refers to."
            },
            "source": {
              "type": "string",
              "description": "WB = World Bank WDI, UN-WPP = UN World Population Prospects 2024, UN-DESA = UN International Migrant Stock 2024.",
              "enum": [
                "WB",
                "UN-WPP",
                "UN-DESA"
              ]
            }
          },
          "additionalProperties": false
        },
        "tfr": {
          "type": [
            "object",
            "null"
          ],
          "description": "Total fertility rate, births per woman (latest of World Bank / UN).",
          "required": [
            "value",
            "year",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number",
              "description": "The value."
            },
            "year": {
              "type": "integer",
              "description": "Year the value refers to."
            },
            "source": {
              "type": "string",
              "description": "WB = World Bank WDI, UN-WPP = UN World Population Prospects 2024, UN-DESA = UN International Migrant Stock 2024.",
              "enum": [
                "WB",
                "UN-WPP",
                "UN-DESA"
              ]
            }
          },
          "additionalProperties": false
        },
        "medianAge": {
          "type": [
            "object",
            "null"
          ],
          "description": "Median age in years (UN WPP).",
          "required": [
            "value",
            "year",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number",
              "description": "The value."
            },
            "year": {
              "type": "integer",
              "description": "Year the value refers to."
            },
            "source": {
              "type": "string",
              "description": "WB = World Bank WDI, UN-WPP = UN World Population Prospects 2024, UN-DESA = UN International Migrant Stock 2024.",
              "enum": [
                "WB",
                "UN-WPP",
                "UN-DESA"
              ]
            }
          },
          "additionalProperties": false
        },
        "share65": {
          "type": [
            "object",
            "null"
          ],
          "description": "% of the population aged 65+ (latest of World Bank / UN).",
          "required": [
            "value",
            "year",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number",
              "description": "The value."
            },
            "year": {
              "type": "integer",
              "description": "Year the value refers to."
            },
            "source": {
              "type": "string",
              "description": "WB = World Bank WDI, UN-WPP = UN World Population Prospects 2024, UN-DESA = UN International Migrant Stock 2024.",
              "enum": [
                "WB",
                "UN-WPP",
                "UN-DESA"
              ]
            }
          },
          "additionalProperties": false
        },
        "components": {
          "type": [
            "object",
            "null"
          ],
          "description": "Demographic balance for the latest UN estimate year: population change = births - deaths + net migration.",
          "required": [
            "year",
            "births",
            "deaths",
            "naturalChange",
            "netMigration",
            "populationChange",
            "perThousand",
            "migrationOffsetPct"
          ],
          "properties": {
            "year": {
              "type": "integer",
              "description": "Year of the demographic balance (latest UN estimate year)."
            },
            "births": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Live births in the year."
            },
            "deaths": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Deaths in the year."
            },
            "naturalChange": {
              "type": [
                "integer",
                "null"
              ],
              "description": "births - deaths."
            },
            "netMigration": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Immigrants minus emigrants in the year (UN WPP)."
            },
            "populationChange": {
              "type": [
                "integer",
                "null"
              ],
              "description": "births - deaths + netMigration."
            },
            "perThousand": {
              "type": "object",
              "description": "Rates per 1,000 mid-year population (same year).",
              "required": [
                "births",
                "deaths",
                "naturalChange",
                "netMigration",
                "populationChange"
              ],
              "properties": {
                "births": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Births per 1,000 people (crude birth rate)."
                },
                "deaths": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Deaths per 1,000 people (crude death rate)."
                },
                "naturalChange": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Births minus deaths per 1,000 people."
                },
                "netMigration": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Net migration per 1,000 people."
                },
                "populationChange": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Population change per 1,000 people."
                }
              },
              "additionalProperties": false
            },
            "migrationOffsetPct": {
              "type": [
                "integer",
                "null"
              ],
              "description": "When deaths exceed births: net migration as % of the natural decline (100+ = fully offset; negative = net emigration). Null when births >= deaths."
            }
          },
          "additionalProperties": false
        },
        "migrantStock": {
          "type": [
            "object",
            "null"
          ],
          "description": "UN DESA migrant stock (latest year).",
          "required": [
            "year",
            "immigrants",
            "immigrantsPct",
            "emigrants",
            "emigrantsPct"
          ],
          "properties": {
            "year": {
              "type": "integer",
              "description": "Reference year of the migrant stock estimate."
            },
            "immigrants": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Immigrant stock: people living in the country who were born in another country (inflow proxy)."
            },
            "immigrantsPct": {
              "type": [
                "number",
                "null"
              ],
              "description": "Immigrant stock as % of the population."
            },
            "emigrants": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Emigrant stock: people born in the country who now live abroad (outflow proxy)."
            },
            "emigrantsPct": {
              "type": [
                "number",
                "null"
              ],
              "description": "Emigrant stock as % of the population of origin."
            }
          },
          "additionalProperties": false
        },
        "projection": {
          "type": [
            "object",
            "null"
          ],
          "description": "UN WPP 2024 medium-variant outlook vs the latest estimate year.",
          "required": [
            "population2050",
            "population2100",
            "change2050Pct",
            "change2100Pct",
            "peakYear",
            "halfPopulationYear",
            "naturalDeclineSince"
          ],
          "properties": {
            "population2050": {
              "type": "integer",
              "description": "UN medium-variant population in 2050."
            },
            "population2100": {
              "type": "integer",
              "description": "UN medium-variant population in 2100."
            },
            "change2050Pct": {
              "type": "number",
              "description": "% change from the latest estimate year to 2050."
            },
            "change2100Pct": {
              "type": "number",
              "description": "% change from the latest estimate year to 2100."
            },
            "peakYear": {
              "type": "integer",
              "description": "Year of the highest population, 1950-2100 (estimates + projection)."
            },
            "halfPopulationYear": {
              "type": [
                "integer",
                "null"
              ],
              "description": "First projected year with half (or less) of the latest-estimate population; null if not before 2100."
            },
            "naturalDeclineSince": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Start year of the current run of years with more deaths than births; if births still exceed deaths, the first projected year with more deaths. Null if never by 2100."
            }
          },
          "additionalProperties": false
        },
        "generations": {
          "type": [
            "object",
            "null"
          ],
          "description": "The '100 people' view: each ~30-year generation is (tfr / 2.1) the size of the previous one.",
          "required": [
            "ratio",
            "halvingYears"
          ],
          "properties": {
            "ratio": {
              "type": "number",
              "description": "tfr / 2.1."
            },
            "halvingYears": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Years for each generation's size to halve at this ratio (30-year generations); null if ratio >= 1."
            }
          },
          "additionalProperties": false
        },
        "risk": {
          "type": "object",
          "description": "Risk summary (top 3 factors; all factors in countries/{ISO3}.json and risk.json).",
          "required": [
            "score",
            "tier",
            "rank",
            "factors"
          ],
          "properties": {
            "score": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Population-decline risk score 0-100 (null if inputs are incomplete).",
              "minimum": 0,
              "maximum": 100
            },
            "tier": {
              "type": [
                "string",
                "null"
              ],
              "description": "Risk tier.",
              "enum": [
                "Critical",
                "High",
                "Elevated",
                "Moderate",
                "Low",
                null
              ]
            },
            "rank": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Rank among ranked countries, 1 = highest risk. Null if not ranked.",
              "minimum": 1
            },
            "factors": {
              "type": "array",
              "description": "Plain-English reasons, most important first.",
              "items": {
                "type": "string",
                "description": "Factor."
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
